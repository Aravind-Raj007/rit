{
  "name": "cyberguard-lite",
  "version": "1.0.0",
  "description": "A local-only personal cybersecurity desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "electron-pack": "electron-builder --dir",
    "electron-dist": "electron-builder"
  },
  "keywords": [
    "cybersecurity",
    "electron",
    "nextjs",
    "desktop-app"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "next": "^14.0.0",
    "node-schedule": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.16.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.0.1"
  }

}
